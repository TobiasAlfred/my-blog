---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import { SITE_DATA } from '../constants';
import portraitImage from '../assets/portrait.png';

import '../styles/about.css';

// Gallery photos — add your images to public/images/gallery/ and update this array
interface Photo {
    src: string;
    alt: string;
    caption?: string;
}

const photos: Photo[] = [
    { src: '/images/gallery/photo1.jpg', alt: 'Photo 1', caption: '' },
    { src: '/images/gallery/photo2.jpg', alt: 'Photo 2', caption: '' },
    { src: '/images/gallery/photo3.jpg', alt: 'Photo 3', caption: '' },
    { src: '/images/gallery/photo4.jpg', alt: 'Photo 4', caption: '' },
    { src: '/images/gallery/photo5.jpg', alt: 'Photo 5', caption: '' },
    { src: '/images/gallery/photo6.jpg', alt: 'Photo 6', caption: '' },
    { src: '/images/gallery/photo7.jpg', alt: 'Photo 7', caption: '' },
    { src: '/images/gallery/photo8.jpg', alt: 'Photo 8', caption: '' },
    { src: '/images/gallery/photo9.jpg', alt: 'Photo 9', caption: '' },
    { src: '/images/gallery/photo10.jpg', alt: 'Photo 10', caption: '' },
    { src: '/images/gallery/photo11.jpg', alt: 'Photo 11', caption: '' },
    { src: '/images/gallery/photo12.jpg', alt: 'Photo 12', caption: '' },
];
---

<Layout pageTitle="About">
    <div class="page-container">
        <h1>About me</h1>

        <div class="about-content">
            <div class="about-intro-wrapper centered-column">
                <div class="about-header centered-column">
                    <Image src={portraitImage} alt={SITE_DATA.name} class="about-portrait" />
                    <h2 class="about-name">{SITE_DATA.name}</h2>
                </div>

                <div style="text-align: left; width: 100%;">
                    <p class="intro-text">
                    我习惯在深夜整理自己。</p>
                    <p class="intro-text">
                    那盏台灯还亮着，只是从老家的书桌，移到了写字楼里的格子间。那时候用草稿纸演算未来，现在用表格推演过去——本质上，都是想在混沌里找一条清晰的线。
                    我的线拐过几道弯：从语法的书页翻到德国的站台，从莱希河的黄昏走到成都梧桐树的阴影里。挤进财经院校的门，又在一桩桩写字楼里，学会了另一种语法。毕业我回了家乡，反复听过点钞机的声响，邂逅过无数个荒唐的故事，在人性里反复确认过世界的重量，最后落笔在无数的材料堆里——许多把椅子，量过同一段青春的不同刻度。
                    再后来就是现在。把所有刻度收进一个抽屉，贴上标签，叫做"稳妥"。</p>
                    <p class="intro-text">
                    临近不惑之年了。年少时想把世界翻过来再看看的心气，如今大多磨成了日常的粉末，洒在孩子的作业本、年年体检单和细碎的账目里。旷野变成了轨道，996是默认的时速。轨道没什么不好，它保证你不会迷路。
                    只是偶尔，在深夜关掉电脑的那个瞬间，我会想起那个熬夜学习不肯睡觉的少年。他要是看见现在的我，大概会沉默一会儿，然后说一句：</p>
                    <p class="intro-text">
                    “还行，没全变。”</p>
                    <p class="intro-text">
                    是的，没全变。心气像一块越擦越小的橡皮，但手里，还攥着。</p>
                    <p class="intro-text">
                    这大概就是现在的我：一个学会了看地图、但偶尔还想偏航的人。
                    </p>
                </div>
            </div>

            <section>
                <h2>My Motto</h2>
                <div class="info-card motto-card">
                    <p>
                    "Keep a little fire burning; however small, however hidden."
                    <br>
                    <small>——Cormac McCarthy, <em>The Road</em></small>
                    </p>
                </div>
            </section>

            <style>
              .motto-card p {
                font-style: italic;
                color: #444;
                line-height: 1.8;
                font-size: 1.1rem;
              }

              .motto-card small {
                display: block;
                margin-top: 0.8rem;
                font-style: normal;
                color: #888;
                font-size: 0.85em;
                letter-spacing: 0.02em;
              }
            </style>

            <section>
                <h2>Gallery</h2>
                <p class="intro-text">Some moments worth remembering.</p>
                <div class="gallery-grid" id="gallery-grid">
                    {photos.map((photo, index) => (
                        <div class="gallery-item" data-index={index}>
                            <img
                                src={photo.src}
                                alt={photo.alt}
                                loading="lazy"
                            />
                            {photo.caption && <span class="gallery-caption">{photo.caption}</span>}
                        </div>
                    ))}
                </div>
            </section>

            <!-- Lightbox -->
            <div class="gallery-lightbox" id="gallery-lightbox" aria-hidden="true">
                <button class="gallery-lightbox-close" aria-label="Close">&times;</button>
                <button class="gallery-lightbox-prev" aria-label="Previous">&#10094;</button>
                <button class="gallery-lightbox-next" aria-label="Next">&#10095;</button>
                <div class="gallery-lightbox-content">
                    <img src="" alt="" id="gallery-lightbox-img" />
                    <div class="gallery-lightbox-info" id="gallery-lightbox-info"></div>
                </div>
            </div>

            <section>
                <h2>Contact</h2>
                <p>
                    Collaboration enquiries, methodology debates, and Monoceros Initiative questions are welcome via
                    <a href={`mailto:${SITE_DATA.email}`}>e-mail</a> or
                    <a href={`https://linkedin.com/in/${SITE_DATA.linkedin}`} target="_blank" rel="noopener noreferrer">LinkedIn</a>.
                    Specific enquiries get specific replies. Generic partnership pitches are recycled with great
                    efficiency.
                </p>
            </section>
        </div>
    </div>

    <script>
        // Gallery Lightbox
        (function() {
            const grid = document.getElementById('gallery-grid');
            const lightbox = document.getElementById('gallery-lightbox');
            const lightboxImg = document.getElementById('gallery-lightbox-img');
            const lightboxInfo = document.getElementById('gallery-lightbox-info');
            const closeBtn = lightbox?.querySelector('.gallery-lightbox-close');
            const prevBtn = lightbox?.querySelector('.gallery-lightbox-prev');
            const nextBtn = lightbox?.querySelector('.gallery-lightbox-next');

            if (!grid || !lightbox) return;

            const items = Array.from(grid.querySelectorAll('.gallery-item'));
            let currentIndex = 0;
            let touchStartX = 0;
            let touchEndX = 0;

            function openLightbox(index) {
                currentIndex = index;
                const item = items[index];
                if (!item) return;
                const img = item.querySelector('img');
                const caption = item.querySelector('.gallery-caption');
                if (!img) return;

                lightboxImg.src = img.src;
                lightboxImg.alt = img.alt;
                lightboxInfo.textContent = caption?.textContent || '';
                lightboxInfo.style.display = caption?.textContent ? 'block' : 'none';

                lightbox.setAttribute('aria-hidden', 'false');
                lightbox.classList.add('active');
                document.body.style.overflow = 'hidden';
            }

            function closeLightbox() {
                lightbox.classList.remove('active');
                lightbox.setAttribute('aria-hidden', 'true');
                document.body.style.overflow = '';
                lightboxImg.src = '';
            }

            function showPrev() {
                currentIndex = (currentIndex - 1 + items.length) % items.length;
                openLightbox(currentIndex);
            }

            function showNext() {
                currentIndex = (currentIndex + 1) % items.length;
                openLightbox(currentIndex);
            }

            // Click on thumbnails
            items.forEach((item, index) => {
                item.addEventListener('click', () => openLightbox(index));
            });

            // Close button
            closeBtn?.addEventListener('click', closeLightbox);

            // Prev / Next buttons
            prevBtn?.addEventListener('click', (e) => { e.stopPropagation(); showPrev(); });
            nextBtn?.addEventListener('click', (e) => { e.stopPropagation(); showNext(); });

            // Click on backdrop to close
            lightbox.addEventListener('click', (e) => {
                if (e.target === lightbox) closeLightbox();
            });

            // Keyboard navigation
            document.addEventListener('keydown', (e) => {
                if (!lightbox.classList.contains('active')) return;
                if (e.key === 'Escape') closeLightbox();
                if (e.key === 'ArrowLeft') showPrev();
                if (e.key === 'ArrowRight') showNext();
            });

            // Touch swipe support
            lightbox.addEventListener('touchstart', (e) => {
                touchStartX = e.changedTouches[0].screenX;
            }, { passive: true });

            lightbox.addEventListener('touchend', (e) => {
                touchEndX = e.changedTouches[0].screenX;
                const diff = touchStartX - touchEndX;
                if (Math.abs(diff) > 50) {
                    if (diff > 0) showNext();
                    else showPrev();
                }
            }, { passive: true });
        })();
    </script>
</Layout>