<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <title>朔安 | ShuoAn - Presentations</title>
    <meta name="description" content="Hey，我是朔安。一个 36 岁却依然保持着 20 岁好奇心的金融从业者。" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=LXGW+WenKai:wght@300;400;700&family=Noto+Sans+SC:wght@300;400;500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href={import.meta.env.BASE_URL + 'styles/presentations.css'} />
  </head>
  <body class="page-presentations">
    <!-- Navigation -->
    <nav class="shuoan-nav" id="shuoanNav">
      <a href="#" class="shuoan-nav__brand" onclick="event.preventDefault(); window.scrollTo({top:0,behavior:'smooth'})">朔安</a>
      <ul class="shuoan-nav__links">
        <li><a href={`${import.meta.env.BASE_URL}`}>主页</a></li>
        <li><a href="#about">关于</a></li>
        <li><a href="#skills">足迹</a></li>
        <li><a href="#gallery">画廊</a></li>
      </ul>
      <button class="shuoan-nav__menu" id="mobileMenu" aria-label="Menu">
        <span></span><span></span><span></span>
      </button>
    </nav>

    <!-- Mobile Menu Overlay -->
    <div class="shuoan-mobile-overlay" id="mobileOverlay">
      <a href={`${import.meta.env.BASE_URL}`}>主页</a>
      <a href="#about">关于</a>
      <a href="#skills">足迹</a>
      <a href="#gallery">画廊</a>
    </div>

    <!-- Hero Section -->
    <section class="shuoan-hero" id="hero">
      <div class="shuoan-hero__bg" id="heroBg">
        <img src={import.meta.env.BASE_URL + "images/hero-bg.jpg"} alt="Hero background" />
      </div>
      <div class="shuoan-hero__overlay"></div>
      <div class="shuoan-hero__content">
        <p class="shuoan-hero__caption">DIGITAL NOMAD &amp; FINANCIAL IDEALIST</p>
        <h1 class="shuoan-hero__title" id="heroTitle">
          <span class="line"><span>日拱一卒</span></span>
          <span class="line"><span>功不唐捐</span></span>
        </h1>
        <p class="shuoan-hero__desc">
          Hey，我是朔安。一个 36 岁却依然保持着 20 岁好奇心的金融从业者。我左手处理复杂的金融模型，右手搭建前沿的 AI 应用。如果你也对这个世界抱有理想，我们应该能成为很好的朋友。
        </p>
        <div class="shuoan-hero__avatars">
          <div class="shuoan-avatars">
            <div class="shuoan-avatars__item" style="background: linear-gradient(135deg, hsl(30,40%,75%), hsl(60,35%,65%))"></div>
            <div class="shuoan-avatars__item" style="background: linear-gradient(135deg, hsl(90,40%,75%), hsl(120,35%,65%))"></div>
            <div class="shuoan-avatars__item" style="background: linear-gradient(135deg, hsl(150,40%,75%), hsl(180,35%,65%))"></div>
            <div class="shuoan-avatars__item" style="background: linear-gradient(135deg, hsl(210,40%,75%), hsl(240,35%,65%))"></div>
            <div class="shuoan-avatars__item" style="background: linear-gradient(135deg, hsl(270,40%,75%), hsl(300,35%,65%))"></div>
          </div>
          <a href="#about" class="shuoan-hero__cta" onclick="event.preventDefault(); document.querySelector('#about').scrollIntoView({behavior:'smooth'})">
            了解更多 <span style="display:inline-block">&rarr;</span>
          </a>
        </div>
      </div>
    </section>

    <!-- About Section -->
    <section class="shuoan-about" id="about">
      <div class="shuoan-about__inner">
        <div class="shuoan-about__left">
          <div class="shuoan-about__image" id="aboutImg">
            <img src={import.meta.env.BASE_URL + "images/about-cafe.jpg"} alt="朔安在咖啡馆" />
          </div>
          <div class="shuoan-tags" id="aboutTags">
            <span class="shuoan-tag">做事较真</span>
            <span class="shuoan-tag">赤诚之心</span>
            <span class="shuoan-tag">德语通</span>
            <span class="shuoan-tag">保持好奇</span>
            <span class="shuoan-tag">价值投资者</span>
            <span class="shuoan-tag">理想主义者</span>
            <span class="shuoan-tag">金融从业者</span>
            <span class="shuoan-tag">AI 探索者</span>
          </div>
        </div>
        <div class="shuoan-about__right">
          <p class="shuoan-section-caption">ABOUT ME</p>
          <h2 class="shuoan-section-title" id="aboutTitle">
            <span class="line"><span>认识朔安</span></span>
            <span class="line"><span>不设边界，保持纯粹。</span></span>
          </h2>
          <div class="shuoan-about__text">
            <p>从金融行业的严谨逻辑，到对计算机网络底层协议的痴迷；从能用德语思考哲学问题，到相信 AI 能让更多人实现创作自由。我的世界里没有"不可能"，只有"还没找到方法"。</p>
            <p>十年前进入金融行业时，我以为自己会一直做一个传统的金融分析师。但好奇心驱使我不断向外探索——我学习了计算机网络，从零开始搭建服务器；我精进德语和英语，让自己能直接阅读海森堡的物理原稿和卡夫卡的梦境；我深入 AI 领域，相信技术能让创意民主化。</p>
            <p>36 岁的我，依然保持着 20 岁时的那份热忱。我相信年龄只是一个数字，真正重要的是你对世界的好奇心和持续学习的动力。</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Skills Section Header -->
    <section class="shuoan-skills-header" id="skills">
      <p class="shuoan-section-caption">CAPABILITIES</p>
      <h2 class="shuoan-section-title" id="skillsTitle">
        <span class="line"><span>不只是</span></span>
        <span class="line"><span>你以为的样子</span></span>
      </h2>
    </section>

    <!-- 人生时间线 -->
    <section class="shuoan-timeline">
      <div class="shuoan-timeline__inner">
        <div class="shuoan-timeline__item">
          <div class="shuoan-timeline__content">
            <div class="shuoan-timeline__title">金融之路的起点</div>
            <div class="shuoan-timeline__desc">硕士毕业于财经院校，踏入金融行业。从基层岗位做起，在无数次报表分析和人性实验中，建立起对宏观经济的直觉。</div>
          </div>
          <div class="shuoan-timeline__year">2013 — 2015</div>
          <div class="shuoan-timeline__dot"></div>
        </div>
        <div class="shuoan-timeline__item">
          <div class="shuoan-timeline__content">
            <div class="shuoan-timeline__title">理性与感性的交汇</div>
            <div class="shuoan-timeline__desc">系统学习计算机，从零搭建企业级网络。同时精进德语，梦回奥格斯堡的梦境。技术让我更理性，语言让我更感性。</div>
          </div>
          <div class="shuoan-timeline__year">2015 — 2022</div>
          <div class="shuoan-timeline__dot"></div>
        </div>
        <div class="shuoan-timeline__item">
          <div class="shuoan-timeline__content">
            <div class="shuoan-timeline__title">深度探索 AI 领域</div>
            <div class="shuoan-timeline__desc">开始深入研究人工智能，从机器学习到深度学习。相信技术能让创意民主化，每个人都能成为创作者。在 996 的缝隙中挤出时间学习。</div>
          </div>
          <div class="shuoan-timeline__year">2022 — 2024</div>
          <div class="shuoan-timeline__dot"></div>
        </div>
        <div class="shuoan-timeline__item">
          <div class="shuoan-timeline__content">
            <div class="shuoan-timeline__title">旷野与轨道之间</div>
            <div class="shuoan-timeline__desc">36 岁，在稳妥与冒险之间寻找平衡。左手金融模型，右手 AI 工具。开始记录自己的思考，搭建这个小小的数字花园。依然相信：日拱一卒，功不唐捐。</div>
          </div>
          <div class="shuoan-timeline__year">2025 — 现在</div>
          <div class="shuoan-timeline__dot"></div>
        </div>
      </div>
    </section>

    <!-- Transition -->
    <div class="shuoan-transition"></div>

    <!-- Gallery Section -->
    <section class="shuoan-gallery" id="gallery">
      <div class="shuoan-gallery__inner">
        <div class="shuoan-gallery__header">
          <p class="shuoan-section-caption">GALLERY</p>
          <h2 class="shuoan-section-title" id="galleryTitle">
            <span class="line"><span>生活碎片</span></span>
          </h2>
        </div>
        <div class="shuoan-gallery__grid">
          <div class="shuoan-gallery__item">
            <div class="shuoan-gallery__thumb" style="aspect-ratio: 4/3;">
              <img src={import.meta.env.BASE_URL + "images/life-subway.jpg"} alt="在路上的宁静" />
            </div>
            <div class="shuoan-gallery__info">
              <span class="shuoan-gallery__name">在路上的宁静</span>
            </div>
          </div>
          <div class="shuoan-gallery__item">
            <div class="shuoan-gallery__thumb" style="aspect-ratio: 4/3;">
              <img src={import.meta.env.BASE_URL + "images/life-studio.jpg"} alt="午后工作室" />
            </div>
            <div class="shuoan-gallery__info">
              <span class="shuoan-gallery__name">午后工作室</span>
            </div>
          </div>
          <div class="shuoan-gallery__item">
            <div class="shuoan-gallery__thumb" style="aspect-ratio: 4/3;">
              <img src={import.meta.env.BASE_URL + "images/life-jazz.jpg"} alt="深夜创意灵感" />
            </div>
            <div class="shuoan-gallery__info">
              <span class="shuoan-gallery__name">深夜创意灵感</span>
            </div>
          </div>
          <div class="shuoan-gallery__item">
            <div class="shuoan-gallery__thumb" style="aspect-ratio: 4/3;">
              <img src={import.meta.env.BASE_URL + "images/life-camping.jpg"} alt="星空下的篝火" />
            </div>
            <div class="shuoan-gallery__info">
              <span class="shuoan-gallery__name">星空下的篝火</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="shuoan-cta">
      <div class="shuoan-cta__bg" id="ctaBg">
        <img src={import.meta.env.BASE_URL + "images/footer-bg.jpg"} alt="Footer background" />
      </div>
      <div class="shuoan-cta__overlay"></div>
      <div class="shuoan-cta__content">
        <h2 class="shuoan-cta__title shuoan-section-title" id="ctaTitle">
          <span class="line"><span>Stay hungry, Stay foolish</span></span>
        </h2>
        <a href="mailto:hello@shuoan.me" class="shuoan-cta__email">hello@shuoan.me</a>
      </div>
    </section>

    <!-- Page Footer -->
    <footer class="shuoan-page-footer">
      <div class="shuoan-page-footer__inner">
        <span class="shuoan-page-footer__copyright">&copy; 2026 朔安. All rights reserved.</span>
        <button class="shuoan-page-footer__top" id="backToTop">
          返回顶部
          <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
            <path d="M6 10V2M6 2L2 6M6 2L10 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      </div>
    </footer>

    <script is:inline>
      (function() {
        'use strict';

        var nav = document.getElementById('shuoanNav');
        function onScroll() {
          if (window.scrollY > 100) {
            nav.classList.add('scrolled');
          } else {
            nav.classList.remove('scrolled');
          }
        }
        window.addEventListener('scroll', onScroll, { passive: true });
        onScroll();

        var menuBtn = document.getElementById('mobileMenu');
        var mobileOverlay = document.getElementById('mobileOverlay');
        if (menuBtn && mobileOverlay) {
          menuBtn.addEventListener('click', function() {
            menuBtn.classList.toggle('active');
            mobileOverlay.classList.toggle('active');
            document.body.style.overflow = mobileOverlay.classList.contains('active') ? 'hidden' : '';
          });
          mobileOverlay.querySelectorAll('a').forEach(function(link) {
            link.addEventListener('click', function() {
              menuBtn.classList.remove('active');
              mobileOverlay.classList.remove('active');
              document.body.style.overflow = '';
            });
          });
        }

        document.getElementById('backToTop').addEventListener('click', function() {
          window.scrollTo({ top: 0, behavior: 'smooth' });
        });

        function triggerHero() {
          setTimeout(function() {
            document.getElementById('heroTitle').classList.add('visible');
          }, 300);
          var heroBg = document.querySelector('#heroBg img');
          if (heroBg) {
            heroBg.style.transform = 'scale(1.08)';
            heroBg.style.transition = 'transform 1.8s cubic-bezier(0.16, 1, 0.3, 1)';
            requestAnimationFrame(function() {
              requestAnimationFrame(function() {
                heroBg.style.transform = 'scale(1)';
              });
            });
          }
        }

        function observe(selector, callback, options) {
          options = options || { threshold: 0.15 };
          var elements = document.querySelectorAll(selector);
          if (!elements.length) return;
          var observer = new IntersectionObserver(function(entries) {
            entries.forEach(function(entry) {
              if (entry.isIntersecting) {
                callback(entry.target);
                observer.unobserve(entry.target);
              }
            });
          }, options);
          elements.forEach(function(el) { observer.observe(el); });
        }

        observe('.shuoan-section-title', function(el) { el.classList.add('visible'); });
        observe('.shuoan-about__image', function(el) { el.classList.add('visible'); });
        observe('.shuoan-tags', function(el) { el.classList.add('visible'); });
        observe('.shuoan-gallery__item', function(el) { el.classList.add('visible'); });
        observe('.shuoan-timeline__item', function(el) {
          el.style.opacity = '1';
n          el.style.transform = 'translateY(0)';
        });

        var ctaBg = document.getElementById('ctaBg');
        if (ctaBg) {
          var ctaSection = ctaBg.closest('.shuoan-cta');
          function updateCta() {
            var rect = ctaSection.getBoundingClientRect();
            var progress = Math.max(0, Math.min(1, -rect.top / (ctaSection.offsetHeight - window.innerHeight)));
            ctaBg.style.transform = 'scale(' + (1.1 - progress * 0.1) + ')';
          }
          var ticking = false;
          window.addEventListener('scroll', function() {
            if (!ticking) {
              requestAnimationFrame(function() { updateCta(); ticking = false; });
              ticking = true;
            }
          }, { passive: true });
        }

        var heroContent = document.querySelector('.shuoan-hero__content');
        if (heroContent) {
          heroContent.style.opacity = '0';
          heroContent.style.transform = 'translateY(40px)';
          heroContent.style.transition = 'opacity 1s ease 0.4s, transform 1s ease 0.4s';
          setTimeout(function() {
            heroContent.style.opacity = '1';
            heroContent.style.transform = 'translateY(0)';
          }, 100);
        }

        var timelineItems = document.querySelectorAll('.shuoan-timeline__item');
        timelineItems.forEach(function(item) {
          item.style.opacity = '0';
          item.style.transform = 'translateY(20px)';
          item.style.transition = 'opacity 0.6s ease, transform 0.6s ease';
        });

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', triggerHero);
        } else {
          triggerHero();
        }
      })();
    </script>
  </body>
</html>